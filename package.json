    "debuggers": [
      {
        "type": "qsp",
        "label": "QSP Game",
        "languages": [
          "qsp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "player": {
                "type": "string",
                "markdownDescription": "Name of one of the `players` in `txt2gam.json` to open the game in. Without it, the first one (or `playerExecutable`, or the `qsp.game.playerExecutable` setting)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "qsp",
            "request": "launch",
            "name": "Run QSP Game"
          }
        ],
        "configurationSnippets": [
          {
            "label": "QSP: Run Game",
            "description": "Build and run the QSP game with the configured player.",
            "body": {
              "type": "qsp",
              "request": "launch",
              "name": "Run QSP Game"
            }
          },
          {
            "label": "QSP: Run Game in Another Player",
            "description": "Build the QSP game and open it in one of the players listed in txt2gam.json.",
            "body": {
              "type": "qsp",
              "request": "launch",
              "name": "Run QSP Game in ${1:qSpider}",
              "player": "${1:qSpider}"
            }
          }
        ]
      }
    ],
