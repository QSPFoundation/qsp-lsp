    "configuration": {
      "title": "QSP",
      "properties": {
        "qsp.project.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable project mode: treat all .qsps/.qsrc files in the workspace as parts of one combined game file. Cross-file diagnostics, completions, and navigation will span all project files."
        },
        "qsp.syntaxVersion": {
          "type": "string",
          "enum": [
            "5.9.5",
            "5.9.6"
          ],
          "enumItemLabels": [
            "5.9.5",
            "5.9.6 (dev)"
          ],
          "enumDescriptions": [
            "The last released QSP library (November 2025).",
            "The QSP library's development version: the undefined value ?, INSVAR, ARRKEY, ALIAS, unary plus, COUNTOBJ with a name, variables without a prefix that hold any type, and \\ ; ^ @ ? ending a name."
          ],
          "default": "5.9.5",
          "scope": "window",
          "markdownDescription": "The QSP library the game is written for. Constructs of a newer version are errors, and values are typed by the chosen version's rules. Also set from the status bar item `QSP 5.9.5` at the bottom right."
        },
        "qsp.embeddedExec.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Parse QSP code inside `<a href=\"exec:...\">` link bodies in string literals. When enabled, the embedded code participates in symbol lookup, diagnostics, refactoring, and semantic highlighting just like top-level location code. Disable to skip the extra sub-parse if you don't use exec links."
        },
        "qsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the QSP language server."
        },
        "qsp.diagnostics.duplicateLocations": {
          "type": "boolean",
          "default": true,
          "description": "Report duplicate location names as errors. In project mode, detects cross-file duplicates."
        },
        "qsp.diagnostics.duplicateLabels": {
          "type": "boolean",
          "default": true,
          "description": "Warn about duplicate label definitions within the same location."
        },
        "qsp.diagnostics.duplicateActions": {
          "type": "boolean",
          "default": true,
          "description": "Info about duplicate act statements within the same location."
        },
        "qsp.diagnostics.unreachableLabels": {
          "type": "boolean",
          "default": true,
          "description": "Warn about labels that are not at the start of a line - they are unreachable."
        },
        "qsp.diagnostics.unclosedLocations": {
          "type": "boolean",
          "default": true,
          "description": "Error about locations not closed with '--'."
        },
        "qsp.diagnostics.uninitializedVariables": {
          "type": "boolean",
          "default": true,
          "description": "Warn about variables used but never assigned in any location. In project mode, checks across all project files."
        },
        "qsp.diagnostics.unresolvedLocationRefs": {
          "type": "boolean",
          "default": true,
          "description": "Warn about references to locations not defined in the current file (or project, in project mode)."
        },
        "qsp.diagnostics.unresolvedLabelRefs": {
          "type": "boolean",
          "default": true,
          "description": "Warn about jump statements referencing labels not defined in the same location."
        },
        "qsp.diagnostics.unresolvedActionRefs": {
          "type": "boolean",
          "default": true,
          "description": "Warn about referencing actions not defined anywhere in the file (or project, in project mode)."
        },
        "qsp.diagnostics.unresolvedObjectRefs": {
          "type": "boolean",
          "default": true,
          "description": "Warn about referencing objects not added anywhere in the file (or project, in project mode)."
        },
        "qsp.diagnostics.unusedLocations": {
          "type": "boolean",
          "default": true,
          "description": "Hint about locations that are defined but never referenced from any other location. In project mode, checks across all project files."
        },
        "qsp.diagnostics.unusedLabels": {
          "type": "boolean",
          "default": true,
          "description": "Hint about labels that are defined but never targeted by jump in the same location."
        },
        "qsp.diagnostics.unusedVariables": {
          "type": "boolean",
          "default": true,
          "description": "Hint about variables that are assigned but never read anywhere in the file (or project, in project mode)."
        },
        "qsp.diagnostics.unusedObjects": {
          "type": "boolean",
          "default": true,
          "description": "Hint about objects added but never referenced. In project mode, checks across all project files."
        },
        "qsp.diagnostics.invalidFunctionPrefix": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a function is called with an incompatible type prefix ($, #, %)."
        },
        "qsp.diagnostics.systemVariablePrefix": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a system variable is written with a prefix of another type than it holds: a number (usehtml, nosave, bcolor…) as $usehtml or %usehtml, text (onnewloc, usercom, fname…) as onnewloc or #fname. QSP 5.9.5 ignores a value of the other type; 5.9.6 converts it, so the check is off there."
        },
        "qsp.diagnostics.unsupportedSyntax": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report constructs the chosen `#qsp.syntaxVersion#` doesn't have: in 5.9.5 the undefined value `?`, `INSVAR`, `ARRKEY`, `ALIAS`, unary plus, a space after `@`, a tab before the `_` that joins lines; in 5.9.6 a name with `\\ ; ^ @ ?` in it, which 5.9.6 splits, and a variable named `alias`."
        },
        "qsp.diagnostics.invalidBuiltinArgCount": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a built-in statement or function is called with too few or too many arguments."
        },
        "qsp.diagnostics.deprecatedBuiltins": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an outdated built-in is used (e.g. ADDQST instead of INCLIB), and strike it through."
        },
        "qsp.diagnostics.mixedVariablePrefixes": {
          "type": "boolean",
          "default": true,
          "description": "Info when a variable is accessed with different type prefixes ($, #, %, or none) across the file (or project, in project mode)."
        },
        "qsp.diagnostics.typeMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Info when a variable is assigned a value of the wrong type (e.g. assigning a number to a string variable, or a string to a numeric variable)."
        },
        "qsp.diagnostics.inconsistentLocalPropagation": {
          "type": "boolean",
          "default": true,
          "description": "Warning when a variable in called location is propagated as local by some callers but not others, causing it to behave as local or global depending on the call path."
        },
        "qsp.diagnostics.mixedLocationCallTypes": {
          "type": "boolean",
          "default": true,
          "description": "Info when a location is called inconsistently (mix of func/gosub/goto/desc)."
        },
        "qsp.diagnostics.untrackedDynamicCalls": {
          "type": "boolean",
          "default": true,
          "description": "Info when a dynamic/dyneval call cannot be statically resolved to a specific code block (e.g. the variable has multiple assignments, or the first argument is a complex expression). Local variables and references inside such blocks are not tracked."
        },
        "qsp.diagnostics.missingResultInFunctionCall": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a function-style call (`@loc`, `func`, or a `dyneval` block) never assigns `result`, so the call returns no value."
        },
        "qsp.diagnostics.extraArgsToTargetWithoutArgs": {
          "type": "boolean",
          "default": true,
          "description": "Info when a call passes extra positional arguments but the target location or inline code block never reads `args`. The extras are silently discarded."
        },
        "qsp.diagnostics.shadowsCallFrameBuiltin": {
          "type": "boolean",
          "default": true,
          "description": "Info on `local args` / `local result` declarations. `args` and `result` are already per-call-frame variables, so re-declaring them as `local` is unnecessary — at the top level of a location it has no effect, and inside a nested scope it just hides the outer value."
        },
        "qsp.diagnostics.shadowsPropagatedLocal": {
          "type": "boolean",
          "default": true,
          "description": "Info when a `local x` declaration shadows a local variable propagated in from one or more callers."
        },
        "qsp.diagnostics.maxErrorsPerLocation": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of syntax errors reported per location. Locations exceeding this limit show a single summary warning instead."
        },
        "qsp.diagnostics.maxPerFile": {
          "type": "integer",
          "default": 5000,
          "minimum": 0,
          "description": "Maximum number of problems reported per file, the most severe first; the rest are summed up in one note. A very large game can produce hundreds of thousands, which the editor can't show usefully and which take long to send. 0 reports them all."
        },
        "qsp.diagnostics.maxLocationLines": {
          "type": "integer",
          "default": 500,
          "minimum": 0,
          "description": "Maximum number of lines per location. Locations exceeding this limit show a warning. Set to 0 to disable."
        },
        "qsp.semanticHighlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic highlighting (requires tree-sitter)."
        },
        "qsp.hover.possibleValues": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Possible values' section in variable hovers, listing statically-known assignments to the variable across the file (or project, in project mode)."
        },
        "qsp.hover.maxItemsPerCategory": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of items rendered per category in hover tooltips (e.g. 'Possible values', 'Called from', 'Navigated from', 'Uses globals', 'Also defined in', 'Propagated from/to'). Lists exceeding this limit are truncated with a '…and N more' tail."
        },
        "qsp.crashReports.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record the language server's memory and where its analysis is, and when it stops unexpectedly (e.g. out of memory on a large game) save a crash report to .qsp/crash-reports in the project. Reports hold numbers, neutral names like f01_l0007 and the extension's own function names, never game text; the table of what the neutral names stand for is saved beside the report and is not part of it. Takes effect when the language server restarts."
        },
        "qsp.crashReports.includeAnonymizedCode": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Offer to add it when a crash report is saved.",
            "Add it to every crash report.",
            "Never add it."
          ],
          "default": "ask",
          "description": "Whether a crash report may include the anonymized code of the location the server was analysing: names replaced by neutral ones, the letters of strings and comments by x-es (their quotes, braces, markup and <<…>> code stay), numbers by 0. It keeps the structure that made the analysis fail, so the problem can be reproduced without the game."
        },
        "qsp.debug.performanceLog": {
          "type": "boolean",
          "default": false,
          "description": "Write the time and memory of every analysis phase (parsing, symbols, project aggregates, diagnostics) to the QSP Language Server log. Phases longer than a second are logged anyway. The lines hold only numbers, never file, location or variable names."
        },
        "qsp.game.password": {
          "type": "string",
          "default": "",
          "description": "Password used when exporting to .qsp and tried first when importing a .qsp file. Leave empty to use the default password ('No')."
        },
        "qsp.game.promptPassword": {
          "type": "boolean",
          "default": true,
          "description": "When exporting a game, prompt for the password. The configured password is shown as the default value. Disable to export silently using only the configured password."
        },
        "qsp.game.buildMode": {
          "type": "string",
          "enum": [
            "single",
            "perFile"
          ],
          "enumDescriptions": [
            "Combine all project source files into one .qsp file (the output path comes from txt2gam.json).",
            "Build each source file into its own .qsp next to it (data.qsps → data.qsp). 'Run QSP Game' starts the first file in txt2gam.json order; the game loads the others with INCLIB."
          ],
          "default": "single",
          "description": "How 'Export QSP Game' and 'Run QSP Game' build a project in project mode. A \"buildMode\" field in txt2gam.json overrides this setting for that project."
        },
        "qsp.game.mainFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Regular expression for the project's main file, searched case-insensitively in each source's workspace-relative path (e.g. `^main\\.qsps$`). The first match in build order is moved to the front: in `single` builds its first location starts the game, in `perFile` builds its `.qsp` is the one **Run QSP Game** opens. A build fails if the pattern is invalid or matches nothing. A `mainFile` field in `txt2gam.json` overrides this setting. Leave empty to use the first file in `txt2gam.json` order."
        },
        "qsp.game.mainFileStrategy": {
          "type": "string",
          "enum": [
            "ask",
            "root"
          ],
          "enumDescriptions": [
            "Ask for the main file with a list; if the list is dismissed, put files from the workspace root first.",
            "Don't ask: put files from the workspace root first."
          ],
          "default": "ask",
          "markdownDescription": "How the setup wizard chooses the main file when it creates `txt2gam.json` and no main file is set in `qsp.game.mainFile`. Either way, the chosen file is saved as `mainFile` in `txt2gam.json`."
        },
        "qsp.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the QSP MCP server to AI agents in VS Code (e.g. Copilot agent mode; VS Code 1.101+). It answers questions about the project's locations, references and diagnostics, builds the game and applies renames. Agents outside VS Code can use it through **QSP: Copy MCP Server Config**."
        },
        "qsp.game.playerExecutable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the QSP player executable or script used by the **Run QSP Game** command. The .qsp file path is passed as its argument. Example: `/usr/local/bin/qsp-player` or `C:\\QSP\\player.exe`. `playerExecutable` or `players` in `txt2gam.json` override this setting for the project."
        },
        "qsp.locations.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "Select the location under the cursor in the QSP Locations view."
        },
        "qsp.cache.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep analysis results on disk (in VS Code's storage for this workspace, not in the project) so a project that hasn't changed opens without being analysed again. Takes effect at the next start of the language server. **QSP: Clear Analysis Cache** deletes it."
        },
        "qsp.libraries.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": [],
          "markdownDescription": "URLs of `libraries.json` catalogs for the **QSP Libraries** view, e.g. `https://raw.githubusercontent.com/<user>/<repo>/main/libraries.json`. When two catalogs offer the same library, the first one wins."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "qsp",
        "label": "QSP"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "qsp",
        "scopes": {
          "namespace": [
            "entity.name.section.location.qsp"
          ],
          "variable": [
            "variable.other.readwrite.qsp"
          ],
          "function": [
            "support.function.builtin.qsp"
          ],
          "keyword": [
            "keyword.control.qsp"
          ],
          "string": [
            "string.quoted.qsp"
          ],
          "number": [
            "constant.numeric.qsp"
          ],
          "comment": [
            "comment.line.qsp"
          ],
          "operator": [
            "keyword.operator.qsp"
          ],
          "property": [
            "entity.name.label.qsp"
          ],
          "macro": [
            "entity.name.function.user.qsp"
          ],
          "parameter": [
            "punctuation.definition.variable.type.qsp"
          ],
          "type": [
            "keyword.other.statement.qsp"
          ],
          "method": [
            "support.function.builtin.qsp"
          ],
          "decorator": [
            "punctuation.definition.location.qsp"
          ],
          "enumMember": [
            "comment.line.location-end.qsp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[qsp]": {
        "editor.stickyScroll.defaultModel": "foldingProviderModel"
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "namespace.goto:qsp": {
            "foreground": "#e06c75"
          },
          "type.controlFlow:qsp": {
            "foreground": "#e06c75"
          }
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "qsp.locations",
          "name": "QSP Locations",
          "icon": "$(symbol-namespace)",
          "when": "qsp.hasSources"
        },
        {
          "id": "qsp.libraries",
          "name": "QSP Libraries",
          "icon": "$(library)",
          "when": "qsp.hasSources"
        }
      ]
    }
  },
  "scripts": {
    "build:grammar": "mkdir -p out && cd tree-sitter-qsp && npx tree-sitter generate && npx tree-sitter build --wasm && cp tree-sitter-qsp.wasm ../out/",
    "build:server:node": "esbuild src/server/nodeMain.ts --bundle --outfile=out/server/nodeMain.js --platform=node --format=cjs --external:vscode --target=node18",
    "build:server:worker": "esbuild src/server/analysisWorker.ts --bundle --outfile=out/server/analysisWorker.js --platform=node --format=cjs --target=node18",
    "build:server:browser": "esbuild src/server/browserMain.ts --bundle --outfile=out/server/browserMain.js --platform=browser --format=esm --target=es2020 --external:web-tree-sitter",
    "build:client:node": "esbuild src/client/nodeMain.ts --bundle --outfile=out/client/nodeMain.js --platform=node --format=cjs --external:vscode --target=node18 --alias:txt2gamJs=./vendor/txt2gam/txt2gam.js",
    "build:client:browser": "esbuild src/client/browserMain.ts --bundle --outfile=out/client/browserMain.js --platform=browser --format=esm --external:vscode --external:node:fs --target=es2020 --alias:txt2gamJs=./vendor/txt2gam/txt2gam.js",
    "build:copy-wasm": "cp node_modules/web-tree-sitter/tree-sitter.wasm out/server/tree-sitter.wasm && cp vendor/txt2gam/txt2gam.wasm out/client/txt2gam.wasm",
    "build:mcp": "esbuild src/mcp/server.js --outfile=out/mcp/server.js --target=es5 && esbuild src/mcp/main.ts --bundle --outfile=out/mcp/main.js --platform=node --format=cjs --target=node18 --minify-whitespace --minify-syntax --main-fields=module,main --alias:txt2gamJs=./vendor/txt2gam/txt2gam.js",
    "build:bundles": "npm run build:server:node && npm run build:server:worker && npm run build:server:browser && npm run build:client:node && npm run build:client:browser && npm run build:mcp && npm run build:webview && npm run build:copy-wasm",
    "build:ui-tests": "npm run build:bundles && esbuild test/ui/*.test.ts --outdir=out/test/ui --platform=node --format=cjs --target=node20",
    "fetch:txt2gam": "node scripts/fetchTxt2gam.mjs",
    "build": "npm run fetch:txt2gam && npm run build:grammar && npm run build:server:node && npm run build:server:worker && npm run build:server:browser && npm run build:client:node && npm run build:client:browser && npm run build:mcp && npm run build:webview && npm run build:copy-wasm",
    "watch:server:node": "esbuild src/server/nodeMain.ts --bundle --outfile=out/server/nodeMain.js --platform=node --format=cjs --external:vscode --target=node18 --watch",
    "watch:server:browser": "esbuild src/server/browserMain.ts --bundle --outfile=out/server/browserMain.js --platform=browser --format=esm --target=es2020 --external:web-tree-sitter --watch",
    "watch:client:node": "esbuild src/client/nodeMain.ts --bundle --outfile=out/client/nodeMain.js --platform=node --format=cjs --external:vscode --target=node18 --alias:txt2gamJs=./vendor/txt2gam/txt2gam.js --watch",
    "watch:client:browser": "esbuild src/client/browserMain.ts --bundle --outfile=out/client/browserMain.js --platform=browser --format=esm --external:vscode --external:node:fs --target=es2020 --alias:txt2gamJs=./vendor/txt2gam/txt2gam.js --watch",
    "watch": "npm run watch:server:node & npm run watch:server:browser & npm run watch:client:node & npm run watch:client:browser",
    "lint": "eslint",
    "test": "vitest run",
    "test:ui": "npm run build:ui-tests && vscode-test",
    "check": "bash scripts/build.sh --check",
    "release": "bash scripts/build.sh",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "stress:gen": "node scripts/stress/genGame.mjs",
    "bench:stress": "node scripts/stress/bench.mjs",
    "stress:skeleton": "node scripts/stress/skeleton.mjs",
    "build:webview": "esbuild src/webview/graph.ts --bundle --outfile=out/webview/graph.js --platform=browser --format=iife --target=es2020 --minify"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "^12.0.2"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "d3-force": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "^0.24.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "ovsx": "^1.2.0",
    "tree-sitter-cli": "^0.24.7",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
