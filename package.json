{
  "name": "qsp-lsp",
  "displayName": "QSP Language Support",
  "description": "QSP (Quest Soft Player) game development: IntelliSense, diagnostics, navigation, a jump graph of locations, building .qsp games and an MCP server for AI agents",
  "version": "0.4.0",
  "publisher": "QSPFoundation",
  "license": "MPL-2.0",
  "icon": "icons/qsp-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/QSPFoundation/qsp-lsp.git"
  },
  "homepage": "https://github.com/QSPFoundation/qsp-lsp#readme",
  "qna": "https://github.com/QSPFoundation/qsp-lsp/issues",
  "bugs": {
    "url": "https://github.com/QSPFoundation/qsp-lsp/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Visualization"
  ],
  "keywords": [
    "qsp",
    "quest soft player",
    "interactive fiction",
    "text quest",
    "text adventure",
    "game development",
    "language server",
    "txt2gam"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "activationEvents": [
    "onWebviewPanel:qsp.jumpGraph"
  ],
  "main": "./out/client/nodeMain.js",
  "browser": "./out/client/browserMain.js",
  "contributes": {
    "languages": [
      {
        "id": "qsp",
        "aliases": [
          "QSP",
          "Quest Soft Player"
        ],
        "extensions": [
          ".qsps",
          ".qsrc"
        ],
        "icon": {
          "light": "./icons/qsp-logo.png",
          "dark": "./icons/qsp-logo.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qsp",
        "scopeName": "source.qsp",
        "path": "./syntaxes/qsp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qsp",
        "path": "./snippets/qsp.json"
      }
    ],
